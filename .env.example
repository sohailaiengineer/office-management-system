# ==============================================================================
# OFFICE MANAGEMENT SYSTEM (OMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# For Vercel production deployment, configure these keys under:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string
FLASK_ENV=production
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 2. LIVE HOSTED MYSQL 8 DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Provide EITHER a unified connection URL (Option A) OR discrete credentials (Option B).

# OPTION A: Unified Connection URL (Recommended for TiDB, Aiven, Railway, PlanetScale)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database>?charset=utf8mb4&ssl_mode=REQUIRED
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@your-aiven-host.aivencloud.com:21345/defaultdb?charset=utf8mb4&ssl_mode=REQUIRED

# OPTION B: Discrete Connection Parameters (Auto-detected if DATABASE_URL is unset)
# DB_HOST=your-mysql8-host.com
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=oms_db
# DB_SSL_MODE=REQUIRED

# Optional Serverless Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave blank or configure with your corporate email provider / Gmail App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-company-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=OMS Enterprise <no-reply@enterprise-oms.com>
