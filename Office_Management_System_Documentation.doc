<!-- ======================================================== -->
<h1>7. Enterprise Reports &amp; Analytics Hub (47 Operational Reports)</h1>
<p>
  The OMS Reports Hub (<code>/reports/</code>) provides real-time Business Intelligence powered by dynamic SQL queries across the live relational database. Every report supports instant streaming download in raw <strong>CSV</strong> format and styled <strong>Microsoft Excel (<code>.xlsx</code>)</strong> format using OpenPyXL.
</p>

<table>
  <thead>
    <tr>
      <th style="width: 15%;">Report Code</th>
      <th style="width: 15%;">Category</th>
      <th style="width: 30%;">Report Title</th>
      <th style="width: 40%;">Operational Business Purpose</th>
    </tr>
  </thead>
  <tbody>
    <!-- Employees -->
    <tr><td><code>emp_directory</code></td><td>Employees</td><td>Employee Master Directory</td><td>Complete roster of active employees with department and designation.</td></tr>
    <tr><td><code>emp_dept</code></td><td>Employees</td><td>Employees by Department</td><td>Workforce distribution segmented across corporate departments.</td></tr>
    <tr><td><code>emp_desig</code></td><td>Employees</td><td>Employees by Designation</td><td>Workforce hierarchy grouped by job ranks and designations.</td></tr>
    <tr><td><code>emp_joiners</code></td><td>Employees</td><td>New Joiners Report</td><td>Employees onboarded within the last 12 calendar months.</td></tr>
    <tr><td><code>emp_skills</code></td><td>Employees</td><td>Skills Inventory Report</td><td>Cross-organizational skill competencies and proficiency tiers.</td></tr>
    <tr><td><code>emp_emergency</code></td><td>Employees</td><td>Emergency Contacts Directory</td><td>Primary workplace safety contacts and next-of-kin information.</td></tr>
    <tr><td><code>emp_exp</code></td><td>Employees</td><td>Prior Experience Summary</td><td>Past industry employment tenures and employers of personnel.</td></tr>
    <tr><td><code>emp_edu</code></td><td>Employees</td><td>Educational Qualifications</td><td>Academic degrees, institutions, and major subjects across staff.</td></tr>
    <tr><td><code>emp_docs</code></td><td>Employees</td><td>Document Compliance Tracking</td><td>Audit of submitted identity proofs, resumes, and signed contracts.</td></tr>
    <tr><td><code>emp_salary_band</code></td><td>Employees</td><td>Employee Salary Distribution</td><td>Workforce distributed across salary compensation tiers.</td></tr>
    <!-- Attendance -->
    <tr><td><code>att_daily</code></td><td>Attendance</td><td>Daily Attendance Log</td><td>Real-time daily workforce clock-in and clock-out register.</td></tr>
    <tr><td><code>att_monthly</code></td><td>Attendance</td><td>Monthly Attendance Summary</td><td>Monthly aggregated attendance register with total present days.</td></tr>
    <tr><td><code>att_late</code></td><td>Attendance</td><td>Late Arrivals Log</td><td>Incidents where employees clocked in past scheduled shift grace period.</td></tr>
    <tr><td><code>att_hours</code></td><td>Attendance</td><td>Working Hours Summary</td><td>Cumulative regular and overtime hours logged per staff member.</td></tr>
    <tr><td><code>att_shifts</code></td><td>Attendance</td><td>Shift Allocation Roster</td><td>Active shift schedules, timings, and employee roster assignments.</td></tr>
    <tr><td><code>att_holidays</code></td><td>Attendance</td><td>Corporate Holiday Register</td><td>Corporate annual holiday calendar and recognized non-working days.</td></tr>
    <!-- Leaves -->
    <tr><td><code>leave_summary</code></td><td>Leaves</td><td>Leave Applications Summary</td><td>Aggregate leave application register categorized by approval status.</td></tr>
    <tr><td><code>leave_balance</code></td><td>Leaves</td><td>Employee Leave Balances</td><td>Allocated, consumed, and remaining leave quotas per employee.</td></tr>
    <tr><td><code>leave_dept</code></td><td>Leaves</td><td>Departmental Leave Usage</td><td>Department-level leave consumption comparisons.</td></tr>
    <tr><td><code>leave_types</code></td><td>Leaves</td><td>Leave Type Utilization</td><td>Leave usage distributed across Annual, Sick, Casual, Maternity.</td></tr>
    <tr><td><code>leave_pending</code></td><td>Leaves</td><td>Pending Leave Approvals</td><td>Pending leave applications currently awaiting managerial signoff.</td></tr>
    <!-- Payroll -->
    <tr><td><code>pay_summary</code></td><td>Payroll</td><td>Payroll Disbursement Summary</td><td>Historical batch payroll disbursement summary by month and year.</td></tr>
